{
  "name": "keysptint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content:stats": "node scripts/update-content-stats.mjs",
    "predev": "npm run content:stats",
    "prebuild": "npm run content:stats",
    "pretest": "npm run content:stats",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test",
    "format": "prettier --write src tests scripts index.html vite.config.js package.json .prettierrc.json README.md",
    "format:check": "prettier --check src tests scripts index.html vite.config.js package.json .prettierrc.json README.md"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
